:root {
  --bg: #07111f;
  --panel: rgba(16, 26, 41, 0.9);
  --panel-strong: #131f30;
  --accent: #5cc8ff;
  --accent-strong: #3ea2ff;
  --text: #eef6ff;
  --muted: #8eaac7;
  --soft: #17304d;
  --border: rgba(140, 176, 206, 0.2);
  --shadow: 0 20px 60px rgba(5, 12, 22, 0.5);
}

* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  min-height: 100%;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(92, 200, 255, 0.16), transparent 30%),
    radial-gradient(circle at bottom right, rgba(62, 162, 255, 0.18), transparent 28%),
    var(--bg);
  color: var(--text);
}

body {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 32px;
}

button, input {
  font: inherit;
}

.app-shell {
  width: min(1400px, 100%);
  min-height: 850px;
  display: grid;
  grid-template-columns: 360px minmax(0, 1fr);
  background: rgba(9, 17, 26, 0.78);
  border: 1px solid var(--border);
  border-radius: 28px;
  box-shadow: var(--shadow);
  overflow: hidden;
  backdrop-filter: blur(18px);
}

.sidebar {
  background: rgba(15, 25, 39, 0.96);
  border-right: 1px solid var(--border);
  padding: 24px 18px;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
}

.brand-mark {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  font-weight: 800;
  background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  color: #041521;
}

h1, h2, p {
  margin: 0;
}

.eyebrow {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--muted);
}

.eyebrow.muted {
  margin-bottom: 6px;
}

.search-box {
  margin-bottom: 18px;
}

.search-box input,
.input-group input {
  width: 100%;
  border: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.04);
  color: var(--text);
  border-radius: 12px;
  padding: 12px 14px;
  outline: none;
}

.search-box input:focus,
.input-group input:focus {
  border-color: rgba(92, 200, 255, 0.8);
  box-shadow: 0 0 0 3px rgba(92, 200, 255, 0.12);
}

.channel-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.channel-item {
  width: 100%;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.04);
  color: var(--text);
  border-radius: 16px;
  padding: 14px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-align: left;
  cursor: pointer;
  transition: 0.2s ease;
}

.channel-item:hover,
.channel-item.active {
  background: rgba(92, 200, 255, 0.1);
  border-color: rgba(92, 200, 255, 0.3);
  transform: translateY(-1px);
}

.channel-item strong,
.channel-item small {
  display: block;
}

.channel-item small {
  margin-top: 4px;
  color: var(--muted);
}

.main-panel {
  padding: 24px 28px 28px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
}

.ghost-btn,
.primary-btn {
  border: none;
  border-radius: 12px;
  padding: 11px 18px;
  cursor: pointer;
  transition: 0.2s ease;
}

.ghost-btn {
  background: rgba(255, 255, 255, 0.04);
  color: var(--text);
  border: 1px solid var(--border);
}

.primary-btn {
  background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  color: #041521;
  font-weight: 700;
}

.player-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 18px;
}

.video-wrap {
  position: relative;
  width: 100%;
  min-height: 440px;
  border-radius: 18px;
  overflow: hidden;
  background: linear-gradient(180deg, #050d19, #101b2b);
}

#player {
  width: 100%;
  height: 560px;
  object-fit: cover;
  background: #000;
}

.fallback-message {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 14px;
  background: rgba(0, 0, 0, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--text);
  padding: 10px 12px;
  border-radius: 12px;
}

.hidden {
  display: none;
}

.toolbar {
  display: flex;
  align-items: end;
  gap: 14px;
  margin-top: 20px;
}

.input-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--muted);
}

.meta-grid {
  margin-top: 22px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.meta-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px 16px;
}

.meta-label {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.empty-state {
  padding: 16px;
  color: var(--muted);
  border: 1px dashed var(--border);
  border-radius: 12px;
  text-align: center;
}

@media (max-width: 980px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  .toolbar,
  .meta-grid {
    grid-template-columns: 1fr;
    display: grid;
  }
}
